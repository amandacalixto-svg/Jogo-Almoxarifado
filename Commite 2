          <button class="dialog-option-btn" onclick="resolveClaudemirNeglect('deal')">Aceitar Termo de Compromisso (Meta: Estocar 15 itens)</button>
        `;
      } else {
        // Conversa receptiva corporativa anos 90
        textEl.innerHTML = `Olá, equipe! Vejo que estão na ativa. A produtividade é a chave do sucesso do Supermercado Amanda. Como posso ajudar nas metas hoje?`;

        optionsEl.innerHTML = `
          <button class="dialog-option-btn" onclick="closeDialog()">Verificar Relatório e continuar trabalhando</button>
          <button class="dialog-option-btn" onclick="askClaudemirGoal()">Pedir uma meta de bônus</button>
          <button class="dialog-option-btn" onclick="claudemirCompliment()">"Como estou me saindo?"</button>
        `;
      }
    }

    function closeDialog() {
      document.getElementById('dialog-overlay').classList.add('hidden');
    }

    function resolveClaudemirNeglect(method) {
      if (method === 'fine') {
        if (coins >= 50) {
          coins -= 50;
          neglectedDaysCount = 0;
          claudemirWarningActive = false;
          document.getElementById('claudemir-alert').classList.add('hidden');
          AudioController.playSuccess();
          alertDialog("Claudemir pegou a multa e limpou sua ficha! Volte ao trabalho!");
        } else {
          alertDialog("Você não tem 50 moedas! Terá que aceitar a meta de compromisso!");
        }
      } else {
        // Meta de compromisso
        neglectedDaysCount = 0;
        claudemirWarningActive = false;
        document.getElementById('claudemir-alert').classList.add('hidden');
        score = Math.max(0, score - 50); // penalidade de pontos leve
        alertDialog("Você assinou o termo! Claudemir resetou os alertas mas ficará de olho!");
      }
    }

    function askClaudemirGoal() {
      // Oferece moedas extras
      coins += 20;
      AudioController.playSuccess();
      alertDialog("Claudemir te encarregou de organizar as gôndolas com carinho e te adiantou 20 moedas de bônus corporativo!");
    }

    function claudemirCompliment() {
      if (score > 400) {
        alertDialog("Claudemir ajusta os óculos, sorri e diz: 'Vocês são profissionais de ponta! Orgulho da rede Amanda!'");
      } else {
        alertDialog("Claudemir olha sério: 'Estamos na média, mas exijo agilidade máxima para evitar rupturas de prateleiras!'");
      }
    }

    function alertDialog(msg) {
      const textEl = document.getElementById('dialog-text');
      const optionsEl = document.getElementById('dialog-options');
      textEl.innerText = msg;
      optionsEl.innerHTML = `<button class="dialog-option-btn" onclick="closeDialog()">Entendido, Chefe!</button>`;
    }

    // 19. ATUALIZAÇÃO DOS ESTOQUES HUD SIDEBAR
    function updateUI() {
      document.getElementById('score-val').innerText = String(score).padStart(4, '0');
      document.getElementById('coins-val').innerText = `🪙 ${coins}`;
      document.getElementById('warnings-lbl').innerText = `${neglectedDaysCount} / 3 Dias`;

      // Atualiza a barra de stock das 13 gôndolas na sidebar
      const listEl = document.getElementById('sidebar-stock-list');
      let html = '';
      const maxVal = upgradesActive.cap ? 20 : 10;

      for (let gKey in SUPER_GONDOLAS) {
        const gd = SUPER_GONDOLAS[gKey];
        const pct = (gd.stock / maxVal) * 100;
        let color = gd.messed ? PALETTE.yellow : PRODUCTS[gd.product].color;
        let statusTxt = gd.messed ? '⚠️ BAGUNÇA!' : `${gd.stock}/${maxVal}`;

        html += `
          <div class="stock-item">
            <div class="stock-info">
              <span class="stock-label">
                <span class="stock-dot" style="background-color: ${color};"></span>
                ${gd.label}
              </span>
              <span style="color: ${gd.messed ? 'var(--yellow-accent)' : 'inherit'}; font-weight: ${gd.messed ? 'bold' : 'normal'};">${statusTxt}</span>
            </div>
            <div class="stock-bar-container">
              <div class="stock-bar" style="width: ${pct}%; background-color: ${color};"></div>
            </div>
          </div>
        `;
      }
      listEl.innerHTML = html;
    }

    // 20. COMPRA DE UPGRADES
    function buyUpgrade(type) {
      const prices = { helper: 150, speed: 80, cap: 100, repositor: 200, light: 50, auto: 250 };
      const cost = prices[type];

      if (coins >= cost && !upgradesActive[type]) {
        coins -= cost;
        upgradesActive[type] = true;
        AudioController.playSuccess();
        document.getElementById(`upg-${type}`).classList.add('disabled');

        // Spawn de NPC se comprado
        if (type === 'helper') {
          helperNPCs.push(new HelperNPC());
        } else if (type === 'repositor') {
          repositorNPCs.push(new RepositorNPC());
        }

        updateUI();
      } else {
        AudioController.playError();
      }
    }

    // 21. SIMULAÇÃO EM LOOP (PHYSICS & EVENTOS - 60 FPS)
    function update(dt) {
      if (isPaused || !isGameRunning) return;

      elapsedTime += dt;
      elapsedDayTimer += dt;

      // --- CICLO DIA / NOITE (TURNO) ---
      let dayPct = (elapsedDayTimer / DAY_DURATION) * 100;
      document.getElementById('time-bar-fill').style.width = `${dayPct}%`;

      if (elapsedDayTimer < DAY_DURATION * 0.4) {
        currentShift = 'Manhã';
      } else if (elapsedDayTimer < DAY_DURATION * 0.8) {
        currentShift = 'Tarde';
      } else {
        currentShift = 'Noite';
      }
      document.getElementById('day-lbl').innerText = `📅 Dia ${currentDayNum} - ${currentShift}`;

      // Fim do Dia: Checagem de Negligência
      if (elapsedDayTimer >= DAY_DURATION) {
        elapsedDayTimer = 0;
        currentDayNum++;
        checkEndDayDuties();
      }

      // 1. Atualiza Jogadores
      player1.update(keys, currentEnv === 'warehouse' ? MAP_WAREHOUSE : currentEnv === 'supermarket' ? MAP_SUPERMARKET : MAP_OFFICE, 
                     currentEnv === 'warehouse' ? MAP_WAREHOUSE_COLS : currentEnv === 'supermarket' ? MAP_SUPER_COLS : MAP_OFFICE_COLS,
                     currentEnv === 'warehouse' ? MAP_WAREHOUSE_ROWS : currentEnv === 'supermarket' ? MAP_SUPER_ROWS : MAP_OFFICE_ROWS, dt);

      if (isMultiplayer && player2) {
        player2.update(keys, currentEnv === 'warehouse' ? MAP_WAREHOUSE : currentEnv === 'supermarket' ? MAP_SUPERMARKET : MAP_OFFICE,
                       currentEnv === 'warehouse' ? MAP_WAREHOUSE_COLS : currentEnv === 'supermarket' ? MAP_SUPER_COLS : MAP_OFFICE_COLS,
                       currentEnv === 'warehouse' ? MAP_WAREHOUSE_ROWS : currentEnv === 'supermarket' ? MAP_SUPER_ROWS : MAP_OFFICE_ROWS, dt);
      }

      // 2. Atualiza Câmera
      Camera.update(player1, player2, isMultiplayer, 
                    currentEnv === 'warehouse' ? MAP_WAREHOUSE_COLS : currentEnv === 'supermarket' ? MAP_SUPER_COLS : MAP_OFFICE_COLS,
                    currentEnv === 'warehouse' ? MAP_WAREHOUSE_ROWS : currentEnv === 'supermarket' ? MAP_SUPER_ROWS : MAP_OFFICE_ROWS);

      // 3. Atualiza Caminhão (Galpão)
      if (currentEnv === 'warehouse') {
        if (activeTruck) {
          activeTruck.update(dt);
          if (activeTruck.status === 'finished') activeTruck = null;
        } else {
          nextTruckTimer -= dt;
          if (nextTruckTimer <= 0) {
            activeTruck = new DeliveryTruck();
            nextTruckTimer = baseTruckInterval * (upgradesActive.speed ? 0.6 : 1.0);
          }
        }
      }

      // 4. Reposição Lenta Automática (Upgrade)
      if (upgradesActive.auto) {
        for (let gKey in SUPER_GONDOLAS) {
          const gd = SUPER_GONDOLAS[gKey];
          if (gd.stock < gd.max && Math.random() < 0.0008) { // lento
            // Tenta pegar do galpão
            for (let sKey in WAREHOUSE_SHELVES) {
              const sh = WAREHOUSE_SHELVES[sKey];
              if (sh.product === gd.product && sh.stock > 0) {
                sh.stock--;
                gd.stock++;
                updateUI();
                break;
              }
            }
          }
        }
      }

      // 5. Clientes NPCs (Loja)
      if (currentEnv === 'supermarket') {
        // Spawn de clientes
        if (customerNPCs.length < 5 && Math.random() < 0.008) {
          customerNPCs.push(new CustomerNPC());
        }
        for (let i = customerNPCs.length - 1; i >= 0; i--) {
          const alive = customerNPCs[i].update(dt);
          if (!alive) customerNPCs.splice(i, 1);
        }
      }

      // 6. Ajudante Galpão (IA)
      if (currentEnv === 'warehouse') {
        helperNPCs.forEach(npc => npc.update(dt));
      }

      // 7. Repositor Loja (IA)
      repositorNPCs.forEach(npc => {
        if (currentEnv === npc.mapState) {
          npc.update(dt);
        }
      });

      // 8. Caixas no Chão (Apodrecimento)
      for (let i = deliveryBoxes.length - 1; i >= 0; i--) {
        const ok = deliveryBoxes[i].update(dt);
        if (!ok) {
          // Apodreceu!
          AudioController.playSpoil();
          floatingTexts.push(new FloatingText("PODRE! -10", deliveryBoxes[i].x + 8, deliveryBoxes[i].y - 4, PALETTE.red));
          score = Math.max(0, score - 10);
          
          for(let p=0; p<10; p++) {
            particles.push(new DustParticle(deliveryBoxes[i].x + 8, deliveryBoxes[i].y + 8, '#2b4716'));
          }
          deliveryBoxes.splice(i, 1);
          updateUI();
        }
      }

      // 9. Partículas e Efeitos
      for (let i = particles.length - 1; i >= 0; i--) {
        if (!particles[i].update()) particles.splice(i, 1);
      }
      for (let i = floatingTexts.length - 1; i >= 0; i--) {
        if (!floatingTexts[i].update()) floatingTexts.splice(i, 1);
      }
    }

    // CHECK DE DEVERES (FIM DO TURNO DIA)
    function checkEndDayDuties() {
      let neglected = false;

      // 1. Houve ruptura excessiva no dia?
      if (rupturesCurrentDay > 3) neglected = true;

      // 2. Há gôndolas desorganizadas neste momento?
      for (let gKey in SUPER_GONDOLAS) {
        if (SUPER_GONDOLAS[gKey].messed) {
          neglected = true;
          break;
        }
      }

      // 3. Há caixas perecíveis estragadas não limpas?
      if (neglected) {
        neglectedDaysCount++;
        AudioController.playAlarm();
        floatingTexts.push(new FloatingText("DIA NEGLIGENCIADO!", 160, 60, PALETTE.red));
        
        if (neglectedDaysCount >= 3) {
          claudemirWarningActive = true;
          document.getElementById('claudemir-alert').classList.remove('hidden');
          AudioController.playAlarm();
          
          // Efeito sonoro severo
          setTimeout(() => AudioController.playTone(180, 0.5, 'sawtooth', 0.1, 90), 200);
        }
      } else {
        // Reduz se fez bom serviço
        neglectedDaysCount = Math.max(0, neglectedDaysCount - 1);
        AudioController.playSuccess();
        floatingTexts.push(new FloatingText("DIA PERFEITO! +50$", 160, 60, PALETTE.greenLight));
        coins += 50; // bônus de eficiência!
      }

      rupturesCurrentDay = 0;
      updateUI();
    }

    // 22. RENDERIZAÇÃO (CANVAS PRINCIPAL & MINI-MAPA)
    function draw() {
      ctx.fillStyle = PALETTE.darkGray;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      let mapData = currentEnv === 'warehouse' ? MAP_WAREHOUSE : currentEnv === 'supermarket' ? MAP_SUPERMARKET : MAP_OFFICE;
      let mapCols = currentEnv === 'warehouse' ? MAP_WAREHOUSE_COLS : currentEnv === 'supermarket' ? MAP_SUPER_COLS : MAP_OFFICE_COLS;
      let mapRows = currentEnv === 'warehouse' ? MAP_WAREHOUSE_ROWS : currentEnv === 'supermarket' ? MAP_SUPER_ROWS : MAP_OFFICE_ROWS;

      // 1. DESENHA GRID DO SCENARIO
      for (let r = 0; r < mapRows; r++) {
        for (let c = 0; c < mapCols; c++) {
          const tile = mapData[r][c];
          const dx = c * TILE_SIZE - Camera.x;
          const dy = r * TILE_SIZE - Camera.y;

          // Desenha apenas o que está visível na tela (Frustum Culling)
          if (dx >= -16 && dx <= 320 && dy >= -16 && dy <= 240) {
            if (tile === 0) ctx.drawImage(SpriteSheet.canvas, 0, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 1) ctx.drawImage(SpriteSheet.canvas, 16, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 2) ctx.drawImage(SpriteSheet.canvas, 32, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 3) ctx.drawImage(SpriteSheet.canvas, 48, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 4) ctx.drawImage(SpriteSheet.canvas, 64, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 5) ctx.drawImage(SpriteSheet.canvas, 80, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 6) ctx.drawImage(SpriteSheet.canvas, 96, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 7) ctx.drawImage(SpriteSheet.canvas, 112, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 8) ctx.drawImage(SpriteSheet.canvas, 128, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 9) ctx.drawImage(SpriteSheet.canvas, 144, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 10) ctx.drawImage(SpriteSheet.canvas, 160, 0, 16, 16, dx, dy, 16, 16);
            else if (tile === 11) ctx.drawImage(SpriteSheet.canvas, 176, 0, 16, 16, dx, dy, 16, 16);
          }
        }
      }

      // 2. DESENHA PILHAS DE ITENS NAS PRATELEIRAS (GALPÃO) E GÔNDOLAS (LOJA)
      if (currentEnv === 'warehouse') {
        drawShelfItems(WAREHOUSE_SHELVES);
        drawWarehousePlaques();
        if (activeTruck) activeTruck.draw(ctx);
        helperNPCs.forEach(npc => npc.draw(ctx));
      } 
      else if (currentEnv === 'supermarket') {
        drawShelfItems(SUPER_GONDOLAS);
        drawSupermarketSigns();
        customerNPCs.forEach(npc => npc.draw(ctx));
      } 
      else if (currentEnv === 'office') {
        // Renderiza Claudemir atrás de sua mesa de madeira
        ctx.drawImage(SpriteSheet.canvas, 0, 256, 16, 16, 144 - Camera.x, 80 - Camera.y, 16, 16);
      }

      // Repositores ativos no ambiente
      repositorNPCs.forEach(npc => {
        if (npc.mapState === currentEnv) npc.draw(ctx);
      });

      // 3. CAIXAS NO CHÃO
      deliveryBoxes.forEach(box => box.draw(ctx));

      // 4. PLAYERS
      if (player1) player1.draw(ctx);
      if (isMultiplayer && player2) player2.draw(ctx);

      // 5. ILUMINAÇÃO DE GALPÃO / LOJA
      drawLightingEffects();

      // 6. PARTÍCULAS E FLOATING TEXTS
      particles.forEach(p => p.draw(ctx));
      floatingTexts.forEach(t => t.draw(ctx));

      // 7. MINI-MAPA
      drawMinimap();
    }

    // PILHAS DINÂMICAS DE CAIXAS
    function drawShelfItems(list) {
      for (let sKey in list) {
        const sh = list[sKey];
        const prod = PRODUCTS[sh.product];
        const stock = sh.stock;

        for (let i = 0; i < stock; i++) {
          const side = i % 2;
          const level = Math.floor(i / 2);
          const col = sh.cols[side];
          const row = sh.rows[sh.rows.length - 1 - level];

          if (row !== undefined) {
            const dx = col * TILE_SIZE + (side === 0 ? 2 : 8) - Camera.x;
            const dy = row * TILE_SIZE + 6 - Camera.y;

            // Micro caixinha
            ctx.fillStyle = PALETTE.brown;
            ctx.fillRect(dx, dy, 5, 4);
            ctx.fillStyle = prod.color;
            ctx.fillRect(dx + 1, dy + 1, 3, 2);
          }
        }

        // Ícone de Bagunça se estiver desorganizada (Gôndola)
        if (sh.messed) {
          const flash = Math.floor(Date.now() / 200) % 2 === 0;
          const cx = sh.cols[0] * TILE_SIZE + 4 - Camera.x;
          const cy = sh.rows[0] * TILE_SIZE - 8 - Camera.y;
          
          ctx.fillStyle = flash ? PALETTE.red : PALETTE.yellow;
          ctx.fillRect(cx + 3, cy, 2, 5);
          ctx.fillRect(cx + 3, cy + 6, 2, 2);
        }
      }
    }

    function drawWarehousePlaques() {
      for (let sKey in WAREHOUSE_SHELVES) {
        const sh = WAREHOUSE_SHELVES[sKey];
        const col = sh.cols[0];
        const dx = col * TILE_SIZE + 4 - Camera.x;
        const dy = sh.rows[0] * TILE_SIZE - 8 - Camera.y;

        ctx.fillStyle = PALETTE.black;
        ctx.fillRect(dx - 1, dy - 1, 10, 8);
        ctx.fillStyle = PALETTE.white;
        ctx.fillRect(dx, dy, 8, 6);
        ctx.fillStyle = PALETTE.black;
        ctx.font = "4px 'Press Start 2P', monospace";
        ctx.fillText(sh.id, dx + 4, dy + 4);
      }
    }

    function drawSupermarketSigns() {
      // Desenha as placas indicadoras suspensas para as 13 seções
      for (let gKey in SUPER_GONDOLAS) {
        const gd = SUPER_GONDOLAS[gKey];
        const dx = gd.cols[0] * TILE_SIZE - Camera.x;
        const dy = gd.rows[0] * TILE_SIZE - 12 - Camera.y;

        ctx.fillStyle = 'rgba(0,0,0,0.6)';
        ctx.fillRect(dx - 4, dy - 2, 24, 8);
        ctx.fillStyle = PRODUCTS[gd.product].color;
        ctx.font = "4px 'Press Start 2P', monospace";
        ctx.textAlign = 'center';
        ctx.fillText(PRODUCTS[gd.product].icon, dx + 8, dy + 4);
      }
    }

    function drawLightingEffects() {
      if (currentEnv === 'office') return;
      const lights = currentEnv === 'warehouse' ? [80, 240, 400, 560] : [100, 300, 500, 700];
      lights.forEach(lx => {
        const drawLX = lx - Camera.x;
        if (drawLX > -40 && drawLX < 360) {
          ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
          ctx.beginPath();
          ctx.moveTo(drawLX - 20, 0);
          ctx.lineTo(drawLX + 20, 0);
          ctx.lineTo(drawLX + 60, 240);
          ctx.lineTo(drawLX - 60, 240);
          ctx.closePath();
          ctx.fill();
        }
      });
    }

    // MINI-MAPA RETRÔ
    function drawMinimap() {
      minimapCtx.fillStyle = '#05050e';
      minimapCtx.fillRect(0, 0, minimapCanvas.width, minimapCanvas.height);

      let mapData = currentEnv === 'warehouse' ? MAP_WAREHOUSE : currentEnv === 'supermarket' ? MAP_SUPERMARKET : MAP_OFFICE;
      let mapCols = currentEnv === 'warehouse' ? MAP_WAREHOUSE_COLS : currentEnv === 'supermarket' ? MAP_SUPER_COLS : MAP_OFFICE_COLS;
      let mapRows = currentEnv === 'warehouse' ? MAP_WAREHOUSE_ROWS : currentEnv === 'supermarket' ? MAP_SUPER_ROWS : MAP_OFFICE_ROWS;

      const scaleX = minimapCanvas.width / mapCols;
      const scaleY = minimapCanvas.height / mapRows;

      for (let r = 0; r < mapRows; r++) {
        for (let c = 0; c < mapCols; c++) {
          const tile = mapData[r][c];
          if (tile === 2) {
            minimapCtx.fillStyle = '#222238'; // Parede
            minimapCtx.fillRect(c * scaleX, r * scaleY, scaleX, scaleY);
          } else if (tile === 8 || tile === 9) {
            minimapCtx.fillStyle = '#1b3b5c'; // Prateleiras/Gôndolas
            minimapCtx.fillRect(c * scaleX, r * scaleY, scaleX, scaleY);
          }
        }
      }

      // Pontinho dos Jogadores
      const flash = Math.floor(Date.now() / 200) % 2 === 0;
      if (player1) {
        minimapCtx.fillStyle = flash ? '#ffffff' : '#ff7733';
        minimapCtx.fillRect(Math.floor(player1.x / TILE_SIZE) * scaleX, Math.floor(player1.y / TILE_SIZE) * scaleY, scaleX + 1, scaleY + 1);
      }
      if (isMultiplayer && player2) {
        minimapCtx.fillStyle = flash ? '#ffffff' : '#33ccff';
        minimapCtx.fillRect(Math.floor(player2.x / TILE_SIZE) * scaleX, Math.floor(player2.y / TILE_SIZE) * scaleY, scaleX + 1, scaleY + 1);
      }
    }

    // 23. GAME LOOP
    function gameLoop(timestamp) {
      if (!lastTime) lastTime = timestamp;
      let dt = (timestamp - lastTime) / 1000;
      if (dt > 0.1) dt = 0.1;
      lastTime = timestamp;

      update(dt);
      draw();
      requestAnimationFrame(gameLoop);
    }

    // 24. INICIAR E PAUSAR
    function startGame() {
      document.getElementById('start-screen').classList.add('hidden');
      document.getElementById('gameover-screen').classList.add('hidden');

      score = 0;
      coins = 100; // Começa com 100 moedas para upgrades iniciais!
      elapsedTime = 0;
      elapsedDayTimer = 0;
      currentDayNum = 1;
      neglectedDaysCount = 0;
      rupturesCurrentDay = 0;
      claudemirWarningActive = false;
      document.getElementById('claudemir-alert').classList.add('hidden');

      upgradesActive = { helper: false, speed: false, cap: false, repositor: false, light: false, auto: false };
      
      // Reseta classes disabled
      ['helper', 'speed', 'cap', 'repositor', 'light', 'auto'].forEach(k => {
        document.getElementById(`upg-${k}`).classList.remove('disabled');
      });

      // Zera estoques
      for (let sKey in WAREHOUSE_SHELVES) WAREHOUSE_SHELVES[sKey].stock = 0;
      for (let gKey in SUPER_GONDOLAS) {
        SUPER_GONDOLAS[gKey].stock = 0;
        SUPER_GONDOLAS[gKey].messed = false;
      }

      // Zera entidades
      deliveryBoxes = [];
      particles = [];
      floatingTexts = [];
      customerNPCs = [];
      helperNPCs = [];
      repositorNPCs = [];

      currentEnv = 'warehouse';
      player1 = new Player(150, 150, 1);
      if (isMultiplayer) {
        player2 = new Player(170, 150, 2);
      } else {
        player2 = null;
      }

      isPaused = false;
      isGameRunning = true;
      lastTime = performance.now();

      AudioController.init();
      AudioController.playSuccess();
      updateUI();
    }

    function togglePause() {
      if (!isGameRunning) return;
      isPaused = !isPaused;
      const overlay = document.getElementById('pause-screen');
      if (isPaused) overlay.classList.remove('hidden');
      else {
        overlay.classList.add('hidden');
        lastTime = performance.now();
      }
    }

    // WINDOW LOAD
    window.onload = () => {
      canvas = document.getElementById('game-canvas');
      ctx = canvas.getContext('2d');
      ctx.imageSmoothingEnabled = false;

      minimapCanvas = document.getElementById('minimap-canvas');
      minimapCtx = minimapCanvas.getContext('2d');
      minimapCtx.imageSmoothingEnabled = false;

      SpriteSheet.init();
      updateUI();

      requestAnimationFrame(gameLoop);
    };
  </script>
