    // 5. GERADOR DE SPRITESHEETS DINÂMICOS (RETRO PIXEL GENERATOR)
    const SpriteSheet = {
      canvas: null,
      ctx: null,

      init() {
        this.canvas = document.createElement('canvas');
        this.canvas.width = 400;
        this.canvas.height = 300;
        this.ctx = this.canvas.getContext('2d');
        this.ctx.imageSmoothingEnabled = false;
        this.generateSprites();
      },

      generateSprites() {
        const ctx = this.ctx;

        // 1. Chão Liso Galpão (0,0)
        ctx.fillStyle = PALETTE.lightGray;
        ctx.fillRect(0, 0, 16, 16);
        ctx.fillStyle = PALETTE.medGray;
        ctx.fillRect(1, 2, 1, 1);
        ctx.fillRect(12, 10, 1, 1);

        // 2. Chão Grade Galpão (16,0)
        ctx.fillStyle = PALETTE.lightGray;
        ctx.fillRect(16, 0, 16, 16);
        ctx.fillStyle = PALETTE.medGray;
        ctx.fillRect(16, 0, 16, 1);
        ctx.fillRect(16, 0, 1, 16);
        ctx.fillStyle = PALETTE.brightGray;
        ctx.fillRect(17, 1, 14, 1);

        // 3. Parede Galpão (32,0)
        ctx.fillStyle = PALETTE.brick;
        ctx.fillRect(32, 0, 16, 16);
        ctx.fillStyle = PALETTE.brickLight;
        ctx.fillRect(33, 1, 14, 6);
        ctx.fillStyle = PALETTE.black;
        ctx.fillRect(32, 7, 16, 1);
        ctx.fillStyle = PALETTE.brickLight;
        ctx.fillRect(33, 9, 6, 6);
        ctx.fillRect(41, 9, 6, 6);
        ctx.fillStyle = PALETTE.black;
        ctx.fillRect(32, 15, 16, 1);

        // 4. Chão Madeira Hortifruti (48,0)
        ctx.fillStyle = PALETTE.brown;
        ctx.fillRect(48, 0, 16, 16);
        ctx.fillStyle = PALETTE.brownLight;
        ctx.fillRect(48, 0, 16, 1);
        ctx.fillRect(48, 8, 16, 1);

        // 5. Chão Azulejo Padaria (64,0)
        ctx.fillStyle = PALETTE.white;
        ctx.fillRect(64, 0, 16, 16);
        ctx.fillStyle = PALETTE.brightGray;
        ctx.fillRect(0 + 64, 0, 16, 1);
        ctx.fillRect(0 + 64, 0, 1, 16);
        ctx.fillRect(8 + 64, 0, 1, 16);
        ctx.fillRect(0 + 64, 8, 16, 1);

        // 6. Chão Quadriculado Azul (80,0)
        ctx.fillStyle = '#1e1e38';
        ctx.fillRect(80, 0, 16, 16);
        ctx.fillStyle = '#2d2d4f';
        ctx.fillRect(80, 0, 8, 8);
        ctx.fillRect(88, 8, 8, 8);

        // 7. Faixas de Doca de Carga (96,0)
        ctx.fillStyle = PALETTE.medGray;
