      pet: { id: 'pet', name: 'Pet Shop', shelf: 'S12', color: '#a0522d', icon: '🐾', barId: 'pet', idx: 11 },
      stationery: { id: 'stationery', name: 'Papelaria', shelf: 'S13', color: '#a64dff', icon: '📝', barId: 'stationery', idx: 12 }
    };

    // 3. SINTETIZADOR DE ÁUDIO 8-BIT (WEB AUDIO API)
    let isMuted = false;
    const AudioController = {
      ctx: null,
      init() {
        if (!this.ctx) {
          this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        }
      },
      playTone(freq, duration, type = 'sine', volume = 0.08, slideToFreq = null) {
        if (isMuted) return;
        this.init();
        if (this.ctx.state === 'suspended') this.ctx.resume();
        try {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
          if (slideToFreq) {
            osc.frequency.exponentialRampToValueAtTime(slideToFreq, this.ctx.currentTime + duration);
          }
          gain.gain.setValueAtTime(volume, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + duration);
        } catch (e) {}
      },
      playStep() { this.playTone(60, 0.04, 'triangle', 0.03, 30); },
      playPick() { this.playTone(180, 0.08, 'sine', 0.1, 400); },
      playDrop() { this.playTone(350, 0.09, 'sine', 0.1, 90); },
      playSuccess() {
        const notes = [523.25, 659.25, 783.99, 1046.50];
        notes.forEach((freq, idx) => {
          setTimeout(() => this.playTone(freq, 0.1, 'square', 0.03), idx * 50);
        });
      },
      playError() { this.playTone(130, 0.25, 'sawtooth', 0.08, 50); },
      playHorn() {
        this.playTone(330, 0.12, 'square', 0.05);
        setTimeout(() => this.playTone(330, 0.12, 'square', 0.05), 150);
      },
      playAlarm() {
        this.playTone(880, 0.1, 'sine', 0.07);
        setTimeout(() => this.playTone(660, 0.1, 'sine', 0.07), 100);
      },
      playSpoil() { this.playTone(150, 0.35, 'sawtooth', 0.07, 20); },
      playClean() { this.playTone(400, 0.2, 'sine', 0.08, 800); }
    };

    function toggleMute() {
      isMuted = !isMuted;
      document.getElementById('sound-btn').innerText = isMuted ? '🔇 Som: Mudo' : '🔊 Som: Ativo';
      AudioController.init();
    }

    // 4. MAPAS DO JOGO
    const TILE_SIZE = 16;
    
    // MAPA 1: ALMOXARIFADO AMPLIADO (40x30)
    // 0:Chão Liso, 1:Grade, 2:Parede, 6:Doca, 7:Expedição, 8:Prateleira, 15:Porta Mercado
    const MAP_WAREHOUSE_COLS = 40;
    const MAP_WAREHOUSE_ROWS = 30;
    const MAP_WAREHOUSE = [];
    for (let r = 0; r < MAP_WAREHOUSE_ROWS; r++) {
      let row = [];
      for (let c = 0; c < MAP_WAREHOUSE_COLS; c++) {
        if (r === 0 || c === 0 || c === MAP_WAREHOUSE_COLS - 1) {
          row.push(2); // Paredes externas
        } else if (r === 28 || r === 29) {
          row.push(6); // Doca de Carga embaixo
        } else if (r === 1 && c >= 1 && c <= 3) {
          row.push(7); // Expedição
        } else if (r === 0 && (c === 4 || c === 5)) {
          // Mantém 2 para parede mas define como portal de saída
          row.push(2);
        } else if ((r + c) % 15 === 0) {
          row.push(1); // Grades decorativas
        } else {
          row.push(0); // Chão liso
        }
      }
      MAP_WAREHOUSE.push(row);
    }
    
    // Inserção das 13 prateleiras do galpão no grid
    // Cada prateleira ocupa Coluna X, X+1 e linhas Y a Y+3 (blocos sólidos = 8)
    const WAREHOUSE_SHELVES = {
      'S1': { id: 'S1', product: 'horti', cols: [3, 4], rows: [4,5,6,7], stock: 0, max: 10 },
      'S2': { id: 'S2', product: 'meat', cols: [7, 8], rows: [4,5,6,7], stock: 0, max: 10 },
      'S3': { id: 'S3', product: 'grocery', cols: [11, 12], rows: [4,5,6,7], stock: 0, max: 10 },
      'S4': { id: 'S4', product: 'bakery', cols: [15, 16], rows: [4,5,6,7], stock: 0, max: 10 },
      'S5': { id: 'S5', product: 'dairy', cols: [19, 20], rows: [4,5,6,7], stock: 0, max: 10 },
      'S6': { id: 'S6', product: 'drinks', cols: [23, 24], rows: [4,5,6,7], stock: 0, max: 10 },
      'S7': { id: 'S7', product: 'hygiene', cols: [3, 4], rows: [11,12,13,14], stock: 0, max: 10 },
      'S8': { id: 'S8', product: 'cleaning', cols: [7, 8], rows: [11,12,13,14], stock: 0, max: 10 },
      'S9': { id: 'S9', product: 'bazar', cols: [11, 12], rows: [11,12,13,14], stock: 0, max: 10 },
      'S10': { id: 'S10', product: 'electronics', cols: [15, 16], rows: [11,12,13,14], stock: 0, max: 10 },
      'S11': { id: 'S11', product: 'clothes', cols: [19, 20], rows: [11,12,13,14], stock: 0, max: 10 },
      'S12': { id: 'S12', product: 'pet', cols: [23, 24], rows: [11,12,13,14], stock: 0, max: 10 },
      'S13': { id: 'S13', product: 'stationery', cols: [27, 28], rows: [11,12,13,14], stock: 0, max: 10 }
    };

    // Preenche os blocos das prateleiras na matriz
    for (let sKey in WAREHOUSE_SHELVES) {
      const sh = WAREHOUSE_SHELVES[sKey];
      sh.rows.forEach(r => {
        sh.cols.forEach(c => {
          MAP_WAREHOUSE[r][c] = 8; // sólido prateleira
        });
      });
    }

    // MAPA 2: SUPERMERCADO HORIZONTAL (50x25)
    // 0:Chão Liso, 2:Parede, 9:Gôndola Sólida
    const MAP_SUPER_COLS = 50;
    const MAP_SUPER_ROWS = 25;
    const MAP_SUPERMARKET = [];
    for (let r = 0; r < MAP_SUPER_ROWS; r++) {
      let row = [];
      for (let c = 0; c < MAP_SUPER_COLS; c++) {
        if (r === 0 || r === MAP_SUPER_ROWS - 1 || c === 0 || c === MAP_SUPER_COLS - 1) {
          row.push(2);
        } else {
          row.push(0);
        }
      }
      MAP_SUPERMARKET.push(row);
    }

    // Gôndolas de Vendas no Supermercado
    const SUPER_GONDOLAS = {
      'G_horti': { id: 'G_horti', product: 'horti', cols: [4, 5], rows: [4, 5], stock: 0, max: 10, messed: false, floor: 3, label: '🥦 Hortifruti' },
      'G_meat': { id: 'G_meat', product: 'meat', cols: [9, 10], rows: [4, 5], stock: 0, max: 10, messed: false, floor: 4, label: '🥩 Açougue' },
      'G_grocery': { id: 'G_grocery', product: 'grocery', cols: [14, 15], rows: [4, 5], stock: 0, max: 10, messed: false, floor: 5, label: '🛒 Mercearia' },
      'G_bakery': { id: 'G_bakery', product: 'bakery', cols: [19, 20], rows: [4, 5], stock: 0, max: 10, messed: false, floor: 4, label: '🍞 Padaria' },
      'G_dairy': { id: 'G_dairy', product: 'dairy', cols: [24, 25], rows: [4, 5], stock: 0, max: 10, messed: false, floor: 5, label: '🧀 Frios' },
      'G_drinks': { id: 'G_drinks', product: 'drinks', cols: [29, 30], rows: [4, 5], stock: 0, max: 10, messed: false, floor: 5, label: '🥤 Bebidas' },
      
      'G_hygiene': { id: 'G_hygiene', product: 'hygiene', cols: [4, 5], rows: [12, 13], stock: 0, max: 10, messed: false, floor: 5, label: '🧴 Higiene' },
      'G_cleaning': { id: 'G_cleaning', product: 'cleaning', cols: [9, 10], rows: [12, 13], stock: 0, max: 10, messed: false, floor: 5, label: '🧹 Limpeza' },
      'G_bazar': { id: 'G_bazar', product: 'bazar', cols: [14, 15], rows: [12, 13], stock: 0, max: 10, messed: false, floor: 5, label: '🍳 Bazar' },
      'G_electronics': { id: 'G_electronics', product: 'electronics', cols: [19, 20], rows: [12, 13], stock: 0, max: 10, messed: false, floor: 5, label: '📺 Eletrônicos' },
      'G_clothes': { id: 'G_clothes', product: 'clothes', cols: [24, 25], rows: [12, 13], stock: 0, max: 10, messed: false, floor: 5, label: '👗 Vestuário' },
      'G_pet': { id: 'G_pet', product: 'pet', cols: [29, 30], rows: [12, 13], stock: 0, max: 10, messed: false, floor: 5, label: '🐾 Pet Shop' },
      'G_stationery': { id: 'G_stationery', product: 'stationery', cols: [34, 35], rows: [12, 13], stock: 0, max: 10, messed: false, floor: 5, label: '📝 Papelaria' }
    };

    // Preenche blocos sólidos de gôndolas
    for (let gKey in SUPER_GONDOLAS) {
      const gd = SUPER_GONDOLAS[gKey];
      gd.rows.forEach(r => {
        gd.cols.forEach(c => {
          MAP_SUPERMARKET[r][c] = 9; // bloco de gôndola
        });
      });
      // Pinta chão sob a gôndola e arredores para marcar seção
      for (let cr = gd.rows[0] - 1; cr <= gd.rows[1] + 1; cr++) {
        for (let cc = gd.cols[0] - 1; cc <= gd.cols[1] + 1; cc++) {
          if (MAP_SUPERMARKET[cr][cc] === 0) {
            MAP_SUPERMARKET[cr][cc] = gd.floor; // chão customizado
          }
        }
      }
    }

    // MAPA 3: SALA DO GERENTE (20x15)
    // 0:Chão Madeira Escritório (10), 2:Parede Escritório, 11:Mesa Central
    const MAP_OFFICE_COLS = 20;
    const MAP_OFFICE_ROWS = 15;
    const MAP_OFFICE = [];
    for (let r = 0; r < MAP_OFFICE_ROWS; r++) {
      let row = [];
      for (let c = 0; c < MAP_OFFICE_COLS; c++) {
