    // 16. MECÂNICA DE INTERAÇÃO (ESPAÇO / ENTER)
    function handleInteraction(p) {
      const cellC = Math.floor((p.x + 8) / TILE_SIZE);
      const cellR = Math.floor((p.y + 12) / TILE_SIZE);

      // --- TRASIÇÃO DE MAPAS (PORTAS) ---
      if (currentEnv === 'warehouse') {
        // Porta para o Supermercado no teto (Col 4 ou 5, Row 1 ou 2)
        if (cellR <= 2 && (cellC === 4 || cellC === 5)) {
          changeMap('supermarket', 24, 192); // Nasce na entrada do mercado
          return;
        }
      } 
      else if (currentEnv === 'supermarket') {
        // Porta de volta para o Galpão na lateral esquerda (Col 0 ou 1, Row 11-13)
        if (cellC <= 1 && (cellR >= 11 && cellR <= 13)) {
          changeMap('warehouse', 80, 48); // Volta pro topo do galpão
          return;
        }
        // Porta da Gerência (Col 48 ou 49, Row 5 ou 6)
        if (cellC >= 48 && (cellR === 5 || cellR === 6)) {
          changeMap('office', 144, 208); // Entra no escritório
          return;
        }
      } 
      else if (currentEnv === 'office') {
        // Porta de volta para o Supermercado embaixo (Col 9 ou 10, Row 13 ou 14)
        if (cellR >= 13 && (cellC === 9 || cellC === 10)) {
          changeMap('supermarket', 768, 96); // Sai na gerência do mercado
          return;
        }

        // Interação com Claudemir
        if (Math.hypot(p.x - 144, p.y - 96) < 24) {
          triggerClaudemirDialog();
          return;
        }
      }

      // ---Gameplay Comum de Gestão---
      if (p.inventory) {
        // Carregando caixa -> Tentar guardar
        if (currentEnv === 'warehouse') {
          // Verifica prateleira adjacente no galpão
          let facedShelf = getFacedShelf(p, WAREHOUSE_SHELVES);
          if (facedShelf) {
            storeBoxOnShelf(p, facedShelf);
          } else {
            // Dropa no chão
            dropBoxOnFloor(p);
          }
        } 
        else if (currentEnv === 'supermarket') {
          // Verifica gôndola de venda adjacente
          let facedGondola = getFacedShelf(p, SUPER_GONDOLAS);
          if (facedGondola) {
            storeBoxOnGondola(p, facedGondola);
          } else {
            dropBoxOnFloor(p);
          }
        }
      } 
      else {
        // Mãos Vazias -> Tentar pegar
        let facedBoxIdx = getFacedBoxIndex(p);
        if (facedBoxIdx !== -1) {
          pickBoxFromFloor(p, facedBoxIdx);
          return;
        }

        // Retirar das prateleiras
        if (currentEnv === 'warehouse') {
          let facedShelf = getFacedShelf(p, WAREHOUSE_SHELVES);
          if (facedShelf) retrieveBoxFromShelf(p, facedShelf);
        } 
        else if (currentEnv === 'supermarket') {
          let facedGondola = getFacedShelf(p, SUPER_GONDOLAS);
          if (facedGondola) {
            if (facedGondola.messed) {
              // Limpa a bagunça!
              facedGondola.messed = false;
              AudioController.playClean();
              floatingTexts.push(new FloatingText("ORGANIZADO!", p.x + 8, p.y - 4, PALETTE.greenLight));
              for(let i=0; i<8; i++) particles.push(new StarParticle(p.x+8, p.y, PALETTE.teal));
            } else {
              retrieveBoxFromGondola(p, facedGondola);
            }
          }
        }
      }
    }

    // MÉTODOS DE PEGAR/GUARDAR
    function getFacedShelf(p, shelfList) {
      const dist = 10;
      let tx = p.x + 6;
      let ty = p.y + 10;

      if (p.dir === 'up') ty -= dist;
      else if (p.dir === 'down') ty += dist;
      else if (p.dir === 'left') tx -= dist;
      else if (p.dir === 'right') tx += dist;

      const gc = Math.floor(tx / TILE_SIZE);
      const gr = Math.floor(ty / TILE_SIZE);

      for (let key in shelfList) {
        const sh = shelfList[key];
        if (sh.cols.includes(gc) && sh.rows.includes(gr)) {
          return sh;
        }
      }
      return null;
    }

    function getFacedBoxIndex(p) {
      const interactR = 14;
      const px = p.x + 6;
      const py = p.y + 8;
      for (let i = 0; i < deliveryBoxes.length; i++) {
        const b = deliveryBoxes[i];
        if (Math.hypot(b.x + 8 - px, b.y + 8 - py) <= interactR) return i;
      }
      return -1;
    }

    function pickBoxFromFloor(p, idx) {
      const b = deliveryBoxes[idx];
      p.inventory = b.product;
      p.isCarryingPerishable = b.isPerishable;
      p.perishableTimeLeft = b.timeLeft;
      deliveryBoxes.splice(idx, 1);
      AudioController.playPick();
    }

    function dropBoxOnFloor(p) {
      deliveryBoxes.push(new DeliveryBox(p.x, p.y + 4, p.inventory, p.isCarryingPerishable, p.perishableTimeLeft));
      AudioController.playDrop();
      p.inventory = null;
      p.isCarryingPerishable = false;
    }

    function storeBoxOnShelf(p, shelf) {
      if (shelf.product !== p.inventory) {
        triggerWrongDrop(p);
        return;
      }
      const maxVal = upgradesActive.cap ? 20 : 10;
      if (shelf.stock >= maxVal) {
        floatingTexts.push(new FloatingText("PRATELEIRA CHEIA!", p.x + 6, p.y - 4, PALETTE.yellow));
        AudioController.playError();
        return;
      }
      shelf.stock++;
      score += 10;
      AudioController.playSuccess();
      floatingTexts.push(new FloatingText("+10 PONTOS", p.x + 6, p.y - 4, PALETTE.greenLight));
      p.inventory = null;
      p.isCarryingPerishable = false;
      updateUI();
    }

    function storeBoxOnGondola(p, gd) {
      if (gd.product !== p.inventory) {
        triggerWrongDrop(p);
        return;
      }
      if (gd.messed) {
        floatingTexts.push(new FloatingText("ORGANIZE ANTES!", p.x + 6, p.y - 4, PALETTE.red));
        AudioController.playError();
        return;
      }
      const maxVal = upgradesActive.cap ? 20 : 10;
      if (gd.stock >= maxVal) {
        floatingTexts.push(new FloatingText("GÔNDOLA CHEIA!", p.x + 6, p.y - 4, PALETTE.yellow));
        AudioController.playError();
        return;
      }
      gd.stock++;
      score += 10;
      AudioController.playSuccess();
      floatingTexts.push(new FloatingText("+10 LOJA", p.x + 6, p.y - 4, PALETTE.greenLight));
      p.inventory = null;
      p.isCarryingPerishable = false;
      updateUI();
    }

    function retrieveBoxFromShelf(p, shelf) {
      if (shelf.stock <= 0) return;
      shelf.stock--;
      p.inventory = shelf.product;
      p.isCarryingPerishable = false; // Retirado da prateleira não apodrece
      AudioController.playPick();
      updateUI();
    }

    function retrieveBoxFromGondola(p, gd) {
      if (gd.stock <= 0) return;
      gd.stock--;
      p.inventory = gd.product;
      p.isCarryingPerishable = false;
      AudioController.playPick();
      updateUI();
    }

    function triggerWrongDrop(p) {
      score = Math.max(0, score - 5);
      AudioController.playError();
      floatingTexts.push(new FloatingText("ERRADO! -5", p.x + 6, p.y - 4, PALETTE.red));
      
      let dropX = p.x;
      let dropY = p.y + 4;
      if (p.dir === 'up') dropY += 12;
      else if (p.dir === 'down') dropY -= 12;

      const errBox = new DeliveryBox(dropX, dropY, p.inventory, p.isCarryingPerishable, p.perishableTimeLeft);
      errBox.shakeTimer = 0.5;
      deliveryBoxes.push(errBox);

      p.inventory = null;
      p.isCarryingPerishable = false;
      updateUI();
    }

