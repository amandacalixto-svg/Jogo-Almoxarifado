      meat: { id: 'meat', name: 'Açougue', shelf: 'S2', color: PALETTE.red, icon: '🥩', barId: 'meat', idx: 1 },
      grocery: { id: 'grocery', name: 'Mercearia', shelf: 'S3', color: PALETTE.orange, icon: '🛒', barId: 'grocery', idx: 2 },
      bakery: { id: 'bakery', name: 'Padaria', shelf: 'S4', color: PALETTE.brownLight, icon: '🍞', barId: 'bakery', idx: 3 },
      dairy: { id: 'dairy', name: 'Frios/Latic.', shelf: 'S5', color: PALETTE.yellow, icon: '🧀', barId: 'dairy', idx: 4 },
