        ctx.fillRect(112, 0, 16, 16);
        ctx.fillStyle = PALETTE.teal;
        ctx.fillRect(114, 2, 12, 12);
        ctx.fillStyle = PALETTE.medGray;
        ctx.fillRect(114, 4, 12, 1);
        ctx.fillRect(114, 8, 12, 1);

        // 9. Prateleira Metálica Vazia (128,0)
        ctx.fillStyle = PALETTE.darkGray;
        ctx.fillRect(128, 0, 16, 16);
        ctx.fillStyle = PALETTE.blue;
