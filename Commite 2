        // 13. Caminhão (0,32) - 48x32px
        this.renderTruck(0, 32);

        // 14. Jogador 1 (Laranja) e Jogador 2 (Azul)
        this.renderPlayerAnims(0, 64, PALETTE.orange, PALETTE.orangeDark);
        this.renderPlayerAnims(0, 128, PALETTE.blueP2, PALETTE.navy);

        // 15. NPCs Clientes (0,192) - Cria variações de roupas
        this.renderNPCAnims(0, 192, PALETTE.purple, PALETTE.pink);
        this.renderNPCAnims(64, 192, PALETTE.green, PALETTE.yellow);
        this.renderNPCAnims(128, 192, PALETTE.teal, PALETTE.brightGray);

        // 16. Claudemir (0,256)
        this.renderClaudemir(0, 256);
      },

      renderTruck(dx, dy) {
        const ctx = this.ctx;
        ctx.fillStyle = PALETTE.black;
        ctx.fillRect(dx + 8, dy + 24, 8, 8);
        ctx.fillRect(dx + 32, dy + 24, 8, 8);
        ctx.fillStyle = PALETTE.medGray;
        ctx.fillRect(dx + 10, dy + 26, 4, 4);
        ctx.fillRect(dx + 34, dy + 26, 4, 4);
        ctx.fillStyle = PALETTE.redDark;
        ctx.fillRect(dx + 6, dy + 22, 38, 2);
        ctx.fillStyle = PALETTE.red;
        ctx.fillRect(dx + 32, dy + 6, 14, 16);
        ctx.fillStyle = PALETTE.blueLight;
        ctx.fillRect(dx + 38, dy + 8, 8, 6);
        ctx.fillStyle = PALETTE.brightGray;
        ctx.fillRect(dx, dy, 32, 22);
        ctx.fillStyle = PALETTE.white;
        ctx.fillRect(dx, dy, 32, 1);
      },

      renderPlayerAnims(startX, startY, mainColor, darkColor) {
        const ctx = this.ctx;
        const directions = ['down', 'up', 'left', 'right'];
        const frames = [0, 1, 2, 3];
        const carryStates = [false, true];

        let curY = startY;
        carryStates.forEach(carrying => {
          directions.forEach(dir => {
            frames.forEach(frame => {
              this.drawPlayerFrame(ctx, startX + frame * 16, curY, dir, frame, carrying, mainColor, darkColor);
            });
            curY += 16;
          });
        });
      },

      drawPlayerFrame(ctx, dx, dy, dir, frame, carrying, mainCol, darkCol) {
        let bob = (frame === 1 || frame === 3) ? 1 : 0;
        ctx.fillStyle = 'rgba(0,0,0,0.2)';
        ctx.fillRect(dx + 3, dy + 14, 10, 2);

        // Pernas
        ctx.fillStyle = PALETTE.navy;
        ctx.fillRect(dx + 4, dy + 11 + bob, 2, 4);
        ctx.fillRect(dx + 10, dy + 11 + bob, 2, 4);

        // Tronco (Colete colorido)
        ctx.fillStyle = mainCol;
        ctx.fillRect(dx + 4, dy + 7 + bob, 8, 4);

        // Braços
        if (carrying) {
          ctx.fillStyle = mainCol;
          ctx.fillRect(dx + 2, dy + 3 + bob, 2, 5);
          ctx.fillRect(dx + 12, dy + 3 + bob, 2, 5);
          ctx.fillStyle = PALETTE.skin;
          ctx.fillRect(dx + 2, dy + 2 + bob, 2, 1);
          ctx.fillRect(dx + 12, dy + 2 + bob, 2, 1);
        } else {
          ctx.fillStyle = mainCol;
          ctx.fillRect(dx + 2, dy + 7 + bob + (frame === 1 ? -1 : 0), 2, 4);
          ctx.fillRect(dx + 12, dy + 7 + bob + (frame === 3 ? -1 : 0), 2, 4);
        }

        // Rosto
        ctx.fillStyle = PALETTE.skin;
        ctx.fillRect(dx + 4, dy + 3 + bob, 8, 5);
        ctx.fillStyle = PALETTE.black;
        if (dir === 'down') {
          ctx.fillRect(dx + 5, dy + 5 + bob, 1, 2);
          ctx.fillRect(dx + 10, dy + 5 + bob, 1, 2);
        } else if (dir === 'left') {
          ctx.fillRect(dx + 5, dy + 5 + bob, 1, 2);
        } else if (dir === 'right') {
          ctx.fillRect(dx + 10, dy + 5 + bob, 1, 2);
        }

        // Boné / Capacete
        ctx.fillStyle = mainCol;
        ctx.fillRect(dx + 3, dy + 1 + bob, 10, 3);
        ctx.fillStyle = darkCol;
        ctx.fillRect(dx + 3, dy + 3 + bob, 10, 1);
      },

      renderNPCAnims(startX, startY, clothingCol, hairCol) {
        const ctx = this.ctx;
        // Desenha frame idle e walking simples voltados para baixo/lado
        for (let frame = 0; frame < 4; frame++) {
          let dx = startX + frame * 16;
          let dy = startY;
          let bob = (frame % 2 === 1) ? 1 : 0;
          // Sombra
          ctx.fillStyle = 'rgba(0,0,0,0.15)';
          ctx.fillRect(dx + 4, dy + 14, 8, 2);
          // Pernas
          ctx.fillStyle = PALETTE.medGray;
          ctx.fillRect(dx + 5, dy + 12 + bob, 2, 3);
          ctx.fillRect(dx + 9, dy + 12 + bob, 2, 3);
          // Roupas
          ctx.fillStyle = clothingCol;
          ctx.fillRect(dx + 4, dy + 7 + bob, 8, 5);
          // Cabeça
          ctx.fillStyle = PALETTE.skin;
          ctx.fillRect(dx + 5, dy + 3 + bob, 6, 5);
          // Cabelo
          ctx.fillStyle = hairCol;
          ctx.fillRect(dx + 4, dy + 2 + bob, 8, 2);
          // Cesta de compras
          ctx.fillStyle = PALETTE.brown;
          ctx.fillRect(dx + 11, dy + 8 + bob, 4, 3);
        }
      },

      renderClaudemir(dx, dy) {
        const ctx = this.ctx;
        // Cadeira giratória cinza
        ctx.fillStyle = PALETTE.medGray;
        ctx.fillRect(dx + 3, dy + 8, 10, 8);
        ctx.fillRect(dx + 7, dy + 13, 2, 3);
        ctx.fillStyle = PALETTE.black;
        ctx.fillRect(dx + 4, dy + 15, 8, 1);
        // Terno cinza de Claudemir
        ctx.fillStyle = '#4f4f6b';
        ctx.fillRect(dx + 4, dy + 6, 8, 5);
        ctx.fillStyle = PALETTE.white;
        ctx.fillRect(dx + 7, dy + 6, 2, 3); // Gola camisa
        ctx.fillStyle = PALETTE.red;
        ctx.fillRect(dx + 7, dy + 7, 2, 2); // Gravata vermelha
        // Rosto
        ctx.fillStyle = PALETTE.skin;
        ctx.fillRect(dx + 5, dy + 2, 6, 5);
        // Óculos redondos dourados
        ctx.strokeStyle = PALETTE.yellow;
        ctx.lineWidth = 1;
        ctx.strokeRect(dx + 5, dy + 3, 2, 2);
        ctx.strokeRect(dx + 9, dy + 3, 2, 2);
        // Cabelo grisalho
        ctx.fillStyle = PALETTE.brightGray;
        ctx.fillRect(dx + 4, dy + 1, 8, 2);
      },

      drawBox(ctx, x, y, type, isPerishable = false, flash = false) {
        ctx.fillStyle = PALETTE.brown;
        ctx.fillRect(x + 2, y + 2, 12, 12);
        ctx.fillStyle = PALETTE.brownDark;
        ctx.fillRect(x + 2, y + 13, 12, 1);
        ctx.fillRect(x + 13, y + 2, 1, 12);
        ctx.fillStyle = PALETTE.brownLight;
        ctx.fillRect(x + 2, y + 2, 11, 1);
        ctx.fillRect(x + 2, y + 3, 1, 10);
        ctx.fillStyle = PALETTE.yellowDark;
        ctx.fillRect(x + 7, y + 2, 2, 12);

        // Badge colorida do produto
        const prod = PRODUCTS[type];
        if (prod) {
          ctx.fillStyle = prod.color;
          ctx.fillRect(x + 5, y + 6, 6, 4);
          ctx.fillStyle = PALETTE.white;
          ctx.fillRect(x + 6, y + 7, 2, 2);
        }

        // Alerta de Exclamação para Produtos Perecíveis
        if (isPerishable) {
          ctx.strokeStyle = flash ? PALETTE.red : PALETTE.yellow;
          ctx.strokeRect(x + 1, y + 1, 14, 14);
          ctx.fillStyle = flash ? PALETTE.red : PALETTE.yellow;
          ctx.fillRect(x + 7, y - 3, 2, 3);
          ctx.fillRect(x + 7, y + 1, 2, 1);
        }
      }
    };

    // 6. VIEWPORT RETRÔ COM SCROLLING (CÂMERA)
    const Camera = {
      x: 0,
      y: 0,
      width: 320,
      height: 240,

      update(p1, p2, isMulti, mapCols, mapRows) {
        let targetX = p1.x;
        let targetY = p1.y;

        if (isMulti && p2) {
          // Câmera segue o centro médio entre os dois jogadores
          targetX = (p1.x + p2.x) / 2;
          targetY = (p1.y + p2.y) / 2;
        }

        this.x = targetX - this.width / 2;
        this.y = targetY - this.height / 2;

        const maxW = mapCols * TILE_SIZE;
        const maxH = mapRows * TILE_SIZE;

        this.x = Math.max(0, Math.min(maxW - this.width, this.x));
        this.y = Math.max(0, Math.min(maxH - this.height, this.y));
      }
    };

    // 7. CLASSES DO JOGADOR
    class Player {
      constructor(x, y, pIndex = 1) {
        this.x = x;
        this.y = y;
        this.width = 12;
        this.height = 14;
        this.speed = 1.6;
        this.dir = 'down';
        this.frame = 0;
        this.animTimer = 0;
        this.inventory = null;
        this.isCarryingPerishable = false;
        this.perishableTimeLeft = 0;
        this.isMoving = false;
        this.pIndex = pIndex; // 1 ou 2
      }

      update(keys, mapData, mapCols, mapRows, dt) {
        this.isMoving = false;
        let dx = 0;
        let dy = 0;

        const currentSpeed = (this.inventory ? 0.95 : this.speed) * (upgradesActive.light ? 1.1 : 1.0);

        if (this.pIndex === 1) {
          // Teclado WASD para P1
          if (keys['w']) { dy = -currentSpeed; this.dir = 'up'; this.isMoving = true; }
          else if (keys['s']) { dy = currentSpeed; this.dir = 'down'; this.isMoving = true; }
          if (keys['a']) { dx = -currentSpeed; this.dir = 'left'; this.isMoving = true; }
          else if (keys['d']) { dx = currentSpeed; this.dir = 'right'; this.isMoving = true; }
        } else {
          // Setas do Teclado para P2
          if (keys['arrowup']) { dy = -currentSpeed; this.dir = 'up'; this.isMoving = true; }
          else if (keys['arrowdown']) { dy = currentSpeed; this.dir = 'down'; this.isMoving = true; }
          if (keys['arrowleft']) { dx = -currentSpeed; this.dir = 'left'; this.isMoving = true; }
          else if (keys['arrowright']) { dx = currentSpeed; this.dir = 'right'; this.isMoving = true; }
        }

        if (dx !== 0 && dy !== 0) {
          dx *= 0.707;
          dy *= 0.707;
        }

        // Colisão AABB
        if (dx !== 0) {
          this.x += dx;
          if (this.checkCollision(mapData, mapCols, mapRows)) this.x -= dx;
        }
        if (dy !== 0) {
          this.y += dy;
          if (this.checkCollision(mapData, mapCols, mapRows)) this.y -= dy;
        }

        // Frame
        if (this.isMoving) {
          this.animTimer += dt;
          if (this.animTimer > 0.12) {
            this.frame = (this.frame + 1) % 4;
            this.animTimer = 0;
            if (this.frame === 1 || this.frame === 3) AudioController.playStep();
          }
        } else {
          this.frame = 0;
        }

        // Atualização de Perecível carregado
        if (this.inventory && this.isCarryingPerishable) {
          this.perishableTimeLeft -= dt;
          if (this.perishableTimeLeft <= 0) {
            AudioController.playSpoil();
            floatingTexts.push(new FloatingText("PODRE! -10", this.x + 6, this.y - 4, PALETTE.red));
            score = Math.max(0, score - 10);
            updateUI();
            
            // Fumaça podre verde
            for(let i=0; i<10; i++) {
              particles.push(new DustParticle(this.x + 6, this.y + 8, '#2b4716'));
            }
            this.inventory = null;
            this.isCarryingPerishable = false;
          }
        }
      }

      checkCollision(mapData, mapCols, mapRows) {
        const px = this.x + 2;
        const py = this.y + 7;
        const pw = this.width - 4;
        const ph = this.height - 7;

        if (px < 8 || px + pw > mapCols * TILE_SIZE - 8 || py < 8 || py + ph > mapRows * TILE_SIZE - 8) {
          return true;
        }

        const startC = Math.floor(px / TILE_SIZE);
        const endC = Math.floor((px + pw) / TILE_SIZE);
        const startR = Math.floor(py / TILE_SIZE);
        const endR = Math.floor((py + ph) / TILE_SIZE);

        for (let r = startR; r <= endR; r++) {
          for (let c = startC; c <= endC; c++) {
            if (r >= 0 && r < mapRows && c >= 0 && c < mapCols) {
              const tile = mapData[r][c];
              if (tile === 2 || tile === 8 || tile === 9 || tile === 11) { // Paredes, Prateleiras, Gôndolas, Mesa
                return true;
              }
            }
          }
        }
        return false;
      }

      draw(ctx) {
        let dirIdx = ['down', 'up', 'left', 'right'].indexOf(this.dir);
        let sheetY = (this.pIndex === 1 ? 64 : 128) + dirIdx * 16;
        if (this.inventory) sheetY += 64; // Seção Carregando

        ctx.drawImage(SpriteSheet.canvas, this.frame * 16, sheetY, 16, 16, Math.floor(this.x), Math.floor(this.y), 16, 16);

        if (this.inventory) {
          let bob = (this.frame === 1 || this.frame === 3) ? 1 : 0;
          let flash = Math.floor(Date.now() / 250) % 2 === 0;
          SpriteSheet.drawBox(ctx, Math.floor(this.x), Math.floor(this.y - 11 + bob), this.inventory, this.isCarryingPerishable, flash);
        }
      }
    }

    // 8. CLASSE DE CAIXAS ENTREGUES NA DOCA
    class DeliveryBox {
      constructor(x, y, prod, isPerish = false, tLeft = 30) {
        this.x = x;
        this.y = y;
        this.product = prod;
        this.isPerishable = isPerish;
        this.timeLeft = tLeft;
        this.totalTime = tLeft;
        this.shakeTimer = 0;
      }

      update(dt) {
        if (this.isPerishable) {
          this.timeLeft -= dt;
          if (this.timeLeft <= 0) return false; // Apodreceu
        }
        if (this.shakeTimer > 0) this.shakeTimer -= dt;
        return true;
      }

      draw(ctx) {
        let flash = Math.floor(Date.now() / 250) % 2 === 0;
        let drawX = this.x;
        if (this.shakeTimer > 0) {
          drawX += Math.sin(Date.now() * 0.1) * 1.5;
        }
        SpriteSheet.drawBox(ctx, Math.floor(drawX) - Camera.x, Math.floor(this.y) - Camera.y, this.product, this.isPerishable, flash);

        if (this.isPerishable) {
          const pct = Math.max(0, this.timeLeft / this.totalTime);
          ctx.fillStyle = '#ff0000';
          ctx.fillRect(this.x - Camera.x + 1, this.y - Camera.y - 5, 14, 2);
          ctx.fillStyle = pct > 0.4 ? '#00ff00' : '#ffff00';
          ctx.fillRect(this.x - Camera.x + 1, this.y - Camera.y - 5, 14 * pct, 2);
        }
      }
    }

    // 9. CLASSE CAMINHÃO
    class DeliveryTruck {
      constructor() {
        this.x = 640;
        this.y = 442; // Alinhado com a Doca do Galpão Ampliado
        this.targetX = 280;
        this.status = 'coming';
        this.timer = 0;
        this.stayDuration = 8;
        this.unloaded = false;
      }

      update(dt) {
        if (this.status === 'coming') {
          this.x -= 2;
          if (this.x <= this.targetX) {
            this.x = this.targetX;
            this.status = 'parked';
            AudioController.playHorn();
            this.unload();
          }
        } else if (this.status === 'parked') {
          this.timer += dt;
          if (this.timer >= this.stayDuration) {
            this.status = 'leaving';
          }
        } else if (this.status === 'leaving') {
          this.x -= 2.5;
          if (this.x < -60) this.status = 'finished';
        }
      }

      unload() {
        if (this.unloaded) return;
        this.unloaded = true;

        let numBoxes = Math.floor(Math.random() * 3) + 2; // 2 a 4 caixas
        const keys = Object.keys(PRODUCTS);

        for (let i = 0; i < numBoxes; i++) {
          const type = keys[Math.floor(Math.random() * keys.length)];
          const bx = 40 + (i * 24) + Math.random() * 5;
          const by = 452;
          const isPerish = elapsedTime >= 240 && Math.random() < 0.4; // Perecível após 4 min

          deliveryBoxes.push(new DeliveryBox(bx, by, type, isPerish, 30));
          for (let p = 0; p < 4; p++) {
            particles.push(new DustParticle(bx + 8, by + 8, PALETTE.brightGray));
          }
        }
      }

      draw(ctx) {
        ctx.drawImage(SpriteSheet.canvas, 0, 32, 48, 32, Math.floor(this.x) - Camera.x, Math.floor(this.y - 12) - Camera.y, 48, 32);
      }
    }

    // 10. IA DE AJUDANTES COMPRÁVEIS (UPGRADES)
    class HelperNPC {
      constructor(pIndex = 1) {
        this.x = 200;
        this.y = 200;
        this.speed = 1.1;
        this.dir = 'down';
        this.frame = 0;
        this.animTimer = 0;
        this.inventory = null;
        this.state = 'idle'; // 'idle', 'walking_to_box', 'walking_to_shelf'
        this.targetBox = null;
        this.targetShelf = null;
      }

      update(dt) {
        let targetX = this.x;
        let targetY = this.y;

        if (this.state === 'idle') {
          if (deliveryBoxes.length > 0) {
            // Acha caixa mais próxima
            let minD = Infinity;
            let closest = null;
            deliveryBoxes.forEach(box => {
              let d = Math.hypot(box.x - this.x, box.y - this.y);
              if (d < minD) { minD = d; closest = box; }
            });
            if (closest) {
              this.targetBox = closest;
              this.state = 'walking_to_box';
            }
          } else {
            // Passeia de volta para o meio
            targetX = 200;
            targetY = 200;
          }
        } else if (this.state === 'walking_to_box') {
          // Verifica se caixa sumiu
          if (!deliveryBoxes.includes(this.targetBox)) {
            this.state = 'idle';
            return;
          }
          targetX = this.targetBox.x;
          targetY = this.targetBox.y;

          if (Math.hypot(this.x - targetX, this.y - targetY) < 10) {
            // Pega caixa
            this.inventory = this.targetBox.product;
            deliveryBoxes = deliveryBoxes.filter(b => b !== this.targetBox);
            AudioController.playPick();
            
            // Busca prateleira correspondente com espaço
            this.targetShelf = null;
            for (let sKey in WAREHOUSE_SHELVES) {
              const sh = WAREHOUSE_SHELVES[sKey];
              if (sh.product === this.inventory && sh.stock < sh.max) {
                this.targetShelf = sh;
                break;
              }
            }
            if (this.targetShelf) {
              this.state = 'walking_to_shelf';
            } else {
              // Solta caixa no chão se prateleira cheia
              const bx = this.x;
              const by = this.y + 4;
              deliveryBoxes.push(new DeliveryBox(bx, by, this.inventory));
              this.inventory = null;
              this.state = 'idle';
            }
          }
        } else if (this.state === 'walking_to_shelf') {
          const shCol = this.targetShelf.cols[0];
          const shRow = this.targetShelf.rows[3];
          targetX = shCol * TILE_SIZE;
          targetY = shRow * TILE_SIZE + 16;

          if (Math.hypot(this.x - targetX, this.y - targetY) < 12) {
            if (this.targetShelf.stock < this.targetShelf.max) {
              this.targetShelf.stock++;
              AudioController.playSuccess();
              floatingTexts.push(new FloatingText("+10", this.x + 8, this.y - 4, PALETTE.greenLight));
              for(let i=0; i<6; i++) particles.push(new StarParticle(this.x+8, this.y, PALETTE.yellow));
            } else {
              // Solta no chão
              deliveryBoxes.push(new DeliveryBox(this.x, this.y + 6, this.inventory));
            }
            this.inventory = null;
            this.state = 'idle';
          }
        }

        // Movimentação suave em vetor
        let angle = Math.atan2(targetY - this.y, targetX - this.x);
        let dist = Math.hypot(targetX - this.x, targetY - this.y);
        
        if (dist > 4) {
          this.x += Math.cos(angle) * this.speed;
          this.y += Math.sin(angle) * this.speed;
          this.animTimer += dt;
          if (this.animTimer > 0.15) {
            this.frame = (this.frame + 1) % 4;
            this.animTimer = 0;
          }
          if (Math.abs(Math.cos(angle)) > Math.abs(Math.sin(angle))) {
            this.dir = Math.cos(angle) > 0 ? 'right' : 'left';
          } else {
            this.dir = Math.sin(angle) > 0 ? 'down' : 'up';
          }
        } else {
          this.frame = 0;
        }
      }

      draw(ctx) {
        let dirIdx = ['down', 'up', 'left', 'right'].indexOf(this.dir);
        let sheetY = 192 + dirIdx * 16; // Sprite alternativo de NPC para ajudante
        ctx.drawImage(SpriteSheet.canvas, this.frame * 16, sheetY, 16, 16, Math.floor(this.x) - Camera.x, Math.floor(this.y) - Camera.y, 16, 16);

        if (this.inventory) {
          SpriteSheet.drawBox(ctx, Math.floor(this.x) - Camera.x, Math.floor(this.y - 10) - Camera.y, this.inventory);
        }
      }
    }

    // Repositor Especializado (Transita entre Almoxarifado e Supermercado)
    class RepositorNPC {
      constructor() {
        this.x = 240;
        this.y = 200;
        this.speed = 1.2;
        this.dir = 'down';
        this.frame = 0;
        this.animTimer = 0;
        this.inventory = null;
        this.mapState = 'warehouse'; // 'warehouse', 'supermarket'
        this.state = 'seeking_cargo'; // 'seeking_cargo', 'leaving_warehouse', 'entering_super', 'filling_gondola', 'returning_to_warehouse'
        this.targetProd = null;
      }

      update(dt) {
        let tx = this.x;
        let ty = this.y;

        if (this.state === 'seeking_cargo') {
          // Busca um produto no galpão que esteja em falta na loja
          this.targetProd = null;
          for (let gKey in SUPER_GONDOLAS) {
            const gd = SUPER_GONDOLAS[gKey];
            if (gd.stock < gd.max) {
              // Verifica se tem no galpão
              for (let sKey in WAREHOUSE_SHELVES) {
                const sh = WAREHOUSE_SHELVES[sKey];
                if (sh.product === gd.product && sh.stock > 0) {
                  this.targetProd = gd.product;
                  this.targetShelf = sh;
                  this.targetGondola = gd;
                  this.state = 'walking_to_shelf';
                  break;
                }
              }
            }
            if (this.targetProd) break;
          }
          if (!this.targetProd) {
            tx = 240; ty = 200; // aguarda
          }
        } 
        else if (this.state === 'walking_to_shelf') {
          tx = this.targetShelf.cols[0] * TILE_SIZE;
          ty = this.targetShelf.rows[3] * TILE_SIZE + 16;
          if (Math.hypot(this.x - tx, this.y - ty) < 12) {
            if (this.targetShelf.stock > 0) {
              this.targetShelf.stock--;
              this.inventory = this.targetProd;
              AudioController.playPick();
              this.state = 'leaving_warehouse';
            } else {
              this.state = 'seeking_cargo';
            }
          }
        } 
        else if (this.state === 'leaving_warehouse') {
          // Vai até a porta superior esquerda
          tx = 80; ty = 24;
          if (Math.hypot(this.x - tx, this.y - ty) < 12) {
            this.mapState = 'supermarket';
            this.x = 24; this.y = 192; // Nasce na porta da loja
            this.state = 'filling_gondola';
          }
        } 
        else if (this.state === 'filling_gondola') {
          // Vai até a gôndola correspondente
          tx = this.targetGondola.cols[0] * TILE_SIZE;
          ty = this.targetGondola.rows[1] * TILE_SIZE + 16;

          if (Math.hypot(this.x - tx, this.y - ty) < 12) {
            if (this.targetGondola.stock < this.targetGondola.max) {
              this.targetGondola.stock++;
              AudioController.playSuccess();
              floatingTexts.push(new FloatingText("ESTOCADO!", this.x + 8, this.y - 4, PALETTE.greenLight));
            }
            this.inventory = null;
            this.state = 'returning_to_warehouse';
          }
        } 
        else if (this.state === 'returning_to_warehouse') {
          // Vai até a porta esquerda para voltar ao galpão
          tx = 20; ty = 192;
          if (Math.hypot(this.x - tx, this.y - ty) < 12) {
            this.mapState = 'warehouse';
            this.x = 80; this.y = 32;
            this.state = 'seeking_cargo';
          }
        }

        let angle = Math.atan2(ty - this.y, tx - this.x);
        let dist = Math.hypot(tx - this.x, ty - this.y);
        
        if (dist > 4) {
          this.x += Math.cos(angle) * this.speed;
          this.y += Math.sin(angle) * this.speed;
          this.animTimer += dt;
          if (this.animTimer > 0.15) {
            this.frame = (this.frame + 1) % 4;
            this.animTimer = 0;
          }
          if (Math.abs(Math.cos(angle)) > Math.abs(Math.sin(angle))) {
            this.dir = Math.cos(angle) > 0 ? 'right' : 'left';
          } else {
            this.dir = Math.sin(angle) > 0 ? 'down' : 'up';
          }
        } else {
          this.frame = 0;
        }
      }

      draw(ctx) {
        let dirIdx = ['down', 'up', 'left', 'right'].indexOf(this.dir);
        let sheetY = 192 + dirIdx * 16; // Sprite alternativo
        ctx.drawImage(SpriteSheet.canvas, this.frame * 16 + 64, sheetY, 16, 16, Math.floor(this.x) - Camera.x, Math.floor(this.y) - Camera.y, 16, 16);

        if (this.inventory) {
          SpriteSheet.drawBox(ctx, Math.floor(this.x) - Camera.x, Math.floor(this.y - 10) - Camera.y, this.inventory);
        }
      }
    }

    // 11. INTELIGÂNCIA ARTIFICIAL DOS CLIENTES NPCS
    class CustomerNPC {
      constructor() {
        this.x = 100 + Math.random() * 300;
        this.y = 100 + Math.random() * 200;
        this.speed = 0.95;
        this.dir = 'down';
        this.frame = 0;
        this.animTimer = 0;
        this.targetGondola = null;
        this.state = 'walking'; // 'walking', 'shopping', 'leaving'
        this.timer = 0;
        this.spriteOffset = [0, 64, 128][Math.floor(Math.random() * 3)]; // 3 roupas

        this.selectNewDestination();
      }

      selectNewDestination() {
        const gondolas = Object.keys(SUPER_GONDOLAS);
        const randomKey = gondolas[Math.floor(Math.random() * gondolas.length)];
        this.targetGondola = SUPER_GONDOLAS[randomKey];
        this.state = 'walking';
      }

      update(dt) {
        if (claudemirWarningActive) {
          // Se Claudemir chamou bronca geral, clientes fogem do mercado!
          this.state = 'leaving';
        }

        if (this.state === 'walking') {
          let tx = this.targetGondola.cols[0] * TILE_SIZE;
          let ty = this.targetGondola.rows[1] * TILE_SIZE + 16;

          let angle = Math.atan2(ty - this.y, tx - this.x);
          let dist = Math.hypot(tx - this.x, ty - this.y);

          if (dist > 8) {
            this.x += Math.cos(angle) * this.speed;
            this.y += Math.sin(angle) * this.speed;
            this.animTimer += dt;
            if (this.animTimer > 0.15) {
              this.frame = (this.frame + 1) % 4;
              this.animTimer = 0;
            }
          } else {
            this.state = 'shopping';
            this.timer = 2.0; // Fica 2s olhando a prateleira
          }
        } 
        else if (this.state === 'shopping') {
          this.timer -= dt;
          if (this.timer <= 0) {
            // Tenta COMPRAR
            this.purchaseItem();
            this.selectNewDestination();
          }
        } 
        else if (this.state === 'leaving') {
          // Vai até a porta da esquerda e some
          let tx = 20;
          let ty = 192;
          let angle = Math.atan2(ty - this.y, tx - this.x);
          this.x += Math.cos(angle) * this.speed;
          this.y += Math.sin(angle) * this.speed;
          this.animTimer += dt;
          if (this.animTimer > 0.15) {
            this.frame = (this.frame + 1) % 4;
            this.animTimer = 0;
          }
          if (Math.hypot(this.x - tx, this.y - ty) < 12) {
            return false; // Remove da memória
          }
        }
        return true;
      }

      purchaseItem() {
        if (claudemirWarningActive) return;

        const gd = this.targetGondola;
        
        // Regra: se a gôndola estiver bagunçada, o cliente se recusa a comprar
        if (gd.messed) {
          floatingTexts.push(new FloatingText("🚫 BAGUNÇADO!", this.x + 8, this.y - 4, PALETTE.red));
          AudioController.playError();
          score = Math.max(0, score - 5);
          updateUI();
          return;
        }

        if (gd.stock > 0) {
          gd.stock--;
          score += 10;
          coins += 15; // Ganha 15 moedas virtuais por venda!
          AudioController.playSuccess();
          floatingTexts.push(new FloatingText("COMPRA! +15$", this.x + 8, this.y - 4, PALETTE.greenLight));
          
          for (let i = 0; i < 8; i++) {
            particles.push(new StarParticle(this.x + 8, this.y + 4, PALETTE.yellow));
          }

          // Chance de DESORGANIZAR a prateleira ao comprar (30%)
          if (Math.random() < 0.3) {
            gd.messed = true;
            floatingTexts.push(new FloatingText("⚠️ BAGUNÇA!", gd.cols[0]*TILE_SIZE + 8, gd.rows[0]*TILE_SIZE - 4, PALETTE.yellow));
            AudioController.playAlarm();
          }

          updateUI();
        } else {
          // RUPTURA DE ESTOQUE (Sem produto)
          score = Math.max(0, score - 15);
          coins = Math.max(0, coins - 10);
          AudioController.playAlarm();
          floatingTexts.push(new FloatingText("RUPTURA! -15", this.x + 8, this.y - 4, PALETTE.red));
          rupturesCurrentDay++;
          updateUI();
        }
      }

      draw(ctx) {
        let sheetY = 192;
        ctx.drawImage(SpriteSheet.canvas, this.frame * 16 + this.spriteOffset, sheetY, 16, 16, Math.floor(this.x) - Camera.x, Math.floor(this.y) - Camera.y, 16, 16);
      }
    }

    // 12. CLASSES DE EFEITOS (PARTÍCULAS E POP-UPS)
    class DustParticle {
      constructor(x, y, color = PALETTE.brightGray) {
        this.x = x; this.y = y; this.color = color;
        this.vx = (Math.random() - 0.5) * 0.4;
        this.vy = -Math.random() * 0.3 - 0.1;
        this.size = Math.random() * 2 + 1;
        this.alpha = 1;
        this.decay = Math.random() * 0.03 + 0.02;
      }
      update() {
        this.x += this.vx; this.y += this.vy;
        this.alpha -= this.decay;
        return this.alpha > 0;
      }
      draw(ctx) {
        ctx.fillStyle = this.color;
        ctx.globalAlpha = this.alpha;
        ctx.fillRect(Math.floor(this.x) - Camera.x, Math.floor(this.y) - Camera.y, Math.floor(this.size), Math.floor(this.size));
        ctx.globalAlpha = 1;
      }
    }

    class StarParticle {
      constructor(x, y, color = PALETTE.yellow) {
        this.x = x; this.y = y; this.color = color;
        this.vx = (Math.random() - 0.5) * 1.5;
        this.vy = -Math.random() * 1.2 - 0.4;
        this.alpha = 1;
        this.decay = 0.03;
      }
      update() {
        this.x += this.vx; this.y += this.vy; this.vy += 0.04;
        this.alpha -= this.decay;
        return this.alpha > 0;
      }
      draw(ctx) {
        ctx.fillStyle = this.color;
        ctx.globalAlpha = this.alpha;
        ctx.fillRect(Math.floor(this.x) - Camera.x, Math.floor(this.y) - Camera.y, 2, 2);
        ctx.globalAlpha = 1;
      }
    }

    class FloatingText {
      constructor(text, x, y, color = '#fff') {
        this.text = text; this.x = x; this.y = y; this.color = color;
        this.vy = -0.4; this.alpha = 1;
        this.decay = 0.025;
      }
      update() {
        this.y += this.vy;
        this.alpha -= this.decay;
        return this.alpha > 0;
      }
      draw(ctx) {
        ctx.fillStyle = this.color;
        ctx.font = "6px 'Press Start 2P', monospace";
        ctx.textAlign = 'center';
        ctx.globalAlpha = this.alpha;
        ctx.fillText(this.text, this.x - Camera.x, this.y - Camera.y);
        ctx.globalAlpha = 1;
      }
    }

